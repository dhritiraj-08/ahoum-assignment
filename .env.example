# Copy this file to .env (or export these directly in your shell) and fill
# in real values. .env itself is gitignored -- never commit real API keys.

# Only needed if you want the Groq cloud fallback (see docs/README.md
# "LLM Backend Options"). Not required at all if Ollama is running locally
# with llama3.1 pulled -- that's the default, preferred backend.
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=your_key_here

# Optional -- src/scorer.py already defaults to this. Only set it to
# override, e.g. if Groq changes model availability/access tiers again
# (this has already happened once: "llama-3.1-8b-instant" became
# enterprise-only and started 404ing on developer accounts). Run
# `python main.py --test-groq` to verify whichever model you set here
# actually works before relying on it.
GROQ_MODEL_NAME=openai/gpt-oss-20b
